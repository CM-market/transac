# ============================================================================
# Transac — Production .env template
# Copy this file to `.env` on the deploy server and fill in the secrets.
# This template enumerates EVERY ${VAR} referenced by docker-compose.yml so the
# compose stack is reproducible. Secret values are LEFT BLANK here on purpose;
# provide real values via provisioning (e.g. repo secrets/ CI vars) — never
# commit a real secret, and never default a secret in compose.
# ============================================================================

# ---- Public site / nginx (frontend service + server_name) ----
DOMAIN=transac.site
ENVIRONMENT=production
SERVER_NAME=${DOMAIN}
VITE_TRANSAC_WEBAUTH_RP_ID=${DOMAIN}
VITE_TRANSAC_WEBAUTH_RP_NAME=Transac

# ---- Database (db service) ----
POSTGRES_DB=transac_db
POSTGRES_USER=transac_user
# SECRET — provide at deploy time (e.g. repo secrets). Do not leave a default.
POSTGRES_PASSWORD=

# Full connection string used by the backend. Composed from POSTGRES_* above;
# override only if you run a managed database.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ---- Backend runtime ----
POW_DIFFICULTY=4
POW_TIMEOUT_MINUTES=10
RUN_MIGRATIONS_ON_START=true
RUST_LOG=transac=info,tower_http=info

# SECRET — JWT signing key. Provide at deploy time.
JWT_SECRET=

# ---- Object storage (MinIO) ----
S3_BUCKET_NAME=transac-media
MINIO_ROOT_USER=minioadmin
# SECRET — MinIO root password. Provide at deploy time.
MINIO_ROOT_PASSWORD=

# Backend S3 client talk to MinIO (internal network alias "minio").
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=http://minio:9000

# ---- Let's Encrypt (certbot) ----
# Leave blank to skip automatic issuance (self-signed/dev) or set for ACME.
LETSENCRYPT_EMAIL=
DATA_PATH=./data
